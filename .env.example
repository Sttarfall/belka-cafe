# Скопируйте этот файл в .env и заполните своими значениями
# НИКОГДА не выкладывайте настоящий .env в открытый репозиторий

# Порт, на котором запускается сервер (хостинг обычно подставляет свой PORT автоматически)
PORT=3000

# Секретный ключ для подписи сессий — придумайте длинную случайную строку
SESSION_SECRET=change-this-to-a-long-random-string

# Хэш пароля администратора (НЕ сам пароль, а его bcrypt-хэш)
# Как получить: запустите `npm run seed-password` и введите нужный пароль,
# скрипт выведет готовую строку — вставьте её сюда
ADMIN_PASSWORD_HASH=$2a$10$poqCQ7An4G5vW3mKU8b4.e.CnDGWYWA.TF8VtHsFoQsvUKccfaZzi

# production включает secure-cookie (требует HTTPS, что на хостинге обычно есть по умолчанию)
NODE_ENV=production

# ===== Уведомления о новых бронях и сообщениях (необязательно, но полезно) =====

# --- Email ---
# Если используете Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# SMTP_USER — ваша почта, SMTP_PASS — "пароль приложения" (не обычный пароль от аккаунта!)
# Как получить пароль приложения для Gmail: myaccount.google.com -> Безопасность ->
# Двухэтапная аутентификация -> Пароли приложений

# На какой адрес присылать уведомления (можно тот же, что и SMTP_USER)

# --- Telegram ---
# 1) Напишите @BotFather в Telegram, команда /newbot, получите токен вида 123456:ABC-DEF...
# 2) Напишите своему новому боту любое сообщение (иначе он не сможет вам писать)
# 3) Откройте в браузере: https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
#    и найдите там "chat":{"id":123456789 — это и есть TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

